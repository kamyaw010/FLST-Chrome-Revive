{
  "default_locale": "en",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "19": "img/flstr19.png",
      "24": "img/flstr24.png",
      "32": "img/flstr32.png",
      "38": "img/flstr38.png"
    },
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "commands": {
    "flip-current-tab": {
      "description": "__MSG_commandFlipDescription__",
      "suggested_key": {
        "default": "Alt+N"
      }
    },
    "open-managed-new-tab": {
      "description": "__MSG_commandManagedNewTabDescription__",
      "suggested_key": {
        "default": "Alt+T"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'"
  },
  "description": "__MSG_extensionDescription__",
  "icons": {
    "128": "img/flstr128.png",
    "19": "img/flstr19.png",
    "24": "img/flstr24.png",
    "32": "img/flstr32.png",
    "48": "img/flstr48.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "88",
  "name": "__MSG_extensionName__",
  "permissions": ["storage", "alarms", "tabs"],
  "version": "3.4.4"
}
