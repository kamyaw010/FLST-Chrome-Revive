{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "chrome"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
